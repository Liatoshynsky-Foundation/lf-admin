{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true, // Allow JavaScript files alongside TypeScript files
    "skipLibCheck": true, // Skip checking library types for faster builds
    "strict": true, // Enable strict type-checking options
    "noEmit": true, // Do not emit output files (used for type-checking only)
    "esModuleInterop": true, // Enables compatibility between CommonJS and ES Modules
    "module": "esnext", // Use ESNext module resolution
    "moduleResolution": "node", // Use Node module resolution strategy
    "resolveJsonModule": true, // Allow importing JSON modules
    "isolatedModules": true, // Ensure each file is treated as an isolated module
    "incremental": true, // Enable incremental compilation for faster builds
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./", // Base URL for module resolution
    "paths": {
      "~/*": ["./app/*"],
      "~/src/*": ["./src/*"],
      "~/ds-components/*": ["app/shared/components/design-system/*"],
      "~/components/*": ["app/shared/components/*"],
      "~/constants/*": ["./app/constants/*"],
      "~/middleware/*": ["./src/middleware/*"],
      "~/utils/*": ["./app/lib/utils/*"],
      "~/config/*": ["./app/config/*"],
      "~/hooks/*": ["./app/shared/hooks/*"],
      "~/providers/*": ["./app/shared/providers/*"],
      "~/application/*": ["./src/application/*"],
      "~/domain/*": ["./src/domain/*"],
      "~/container/*": ["./src/container/*"],
      "~/generated-graphql": ["./src/generated/"],
      "~/back-constants/*": ["./src/constants/*"],
      "~/back-config": ["./src/config"],
      "~/back-config/*": ["./src/config/*"],
      "~/infrastructure/*": ["./src/infrastructure/*"],
      "~/interfaces/*": ["./src/interfaces/*"],
      "~/back-shared/*": ["./src/shared/*"],
      "~/validators/*": ["./src/validators/*"],
      "~/uploads": ["./src/uploads"],
      "~/uploads/*": ["./src/uploads/*"],
      "~/public/*": ["./public/*"] // Path alias for easier imports
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "jest.config.ts" // Include Jest config file for TypeScript support
  ],
  "exclude": ["node_modules"] // Exclude node_modules from compilation
}
