{
  "plugins": ["changelog", "released"],
  "baseBranch": "branch",
  "labels": [
    {
      "name": "feat",
      "changelogTitle": "🚀 Features",
      "releaseType": "minor"
    },
    {
      "name": "fix",
      "changelogTitle": "🐛 Fixes",
      "releaseType": "patch"
    },
    {
      "name": "docs",
      "changelogTitle": "📚 Docs",
      "releaseType": "none"
    },
    {
      "name": "style",
      "changelogTitle": "💅 Style",
      "releaseType": "none"
    },
    {
      "name": "refactor",
      "changelogTitle": "💡 Refactor",
      "releaseType": "none"
    },
    {
      "name": "perf",
      "changelogTitle": "⚡️ Performance",
      "releaseType": "none"
    },
    {
      "name": "test",
      "changelogTitle": "✅ Tests",
      "releaseType": "none"
    },
    {
      "name": "build",
      "changelogTitle": "📦 Build",
      "releaseType": "none"
    },
    {
      "name": "ci",
      "changelogTitle": "⚙️ CI/CD",
      "releaseType": "none"
    },
    {
      "name": "chore",
      "changelogTitle": "🔧 Chores",
      "releaseType": "none"
    },
    {
      "name": "revert",
      "changelogTitle": "⏪ Reverts",
      "releaseType": "patch"
    }
  ],
  "changelog": {
    "prepend": true
  }
}